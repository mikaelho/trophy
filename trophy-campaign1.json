    "note/2h3d492223": {
      "created_at": "2026-11-09T14:08:17.776Z",
      "description": "1. Set of silvery keys made of snowflakes and icicles. Includes a set of lock picks in case a key should be lost (very fragile). 4 Coin\n2. Utility belt lined with glowing syringes in gemstone hues—amethyst, emerald, sapphire, ruby. Their effects are unknown (see Loom). 6 Coin\n3. Resplendent cloak in layers of seafoam green, made of the feathers of an unknown bird. Thick enough to function as armour (bloodbound). 6 Coin\n4. Loose pages of a cookbook. Among the recipes—most of which require rare ingredients or parts from dangerous creatures—are scrawled comments for useful remedies and foraging guides for rare plants. 4 Coin\n5. Manual of unarmed sparring techniques as practiced by followers of Saint Helissen. May be studied to improve one’s skill at defense (counts as a weapon; cannot be lost or exhausted). 4 Coin\n6. Copper pot decorated with motifs of the autumn harvest. Any food cooked in it reminds the taster of their childhood (mellows the mood, heals Conditions). 4 Coin",
      "position": 0,
      "title": "Treasures"
    },
    "note/2z13674t4r": {
      "created_at": "2026-11-09T20:55:14.269Z",
      "description": "- Fragile - add 1 extra light die when the equipment is applicable; if it comes up 1-3, the equipment is broken; can perhaps be restored with Coin\n- Cursed - add 1 extra dark die to a Risk roll; you do not want to get rid of it\n- Bloodbound - takes Ruin in your stead; becomes ruinously alive with 3 Ruin",
      "position": 1,
      "title": "Special equipment"
    },
    "person/0j333w1p3s": {
      "created_at": "2026-11-04T21:13:08.066Z",
      "description": "Delinia Alger is the hard-nosed recruiting agent for the kingsguard. Brash, tough and brutally honest, she holds nothing back when denying one entry into their ranks. She seems to revel in telling treasure-hunters that their inevitable deaths await them in the forest.",
      "equipment": "Tube of industrial sealant/tar (6 uses), Tactical throwing hatchet, Skis",
      "location": "Duhrin",
      "look": "Waxen skin, thick, hulking",
      "name": "Delinia Alger",
      "position": 1,
      "title": "Kingsguard recruiter"
    },
    "person/296a6h2q0y": {
      "created_at": "2026-11-05T19:58:17.106Z",
      "description": "",
      "equipment": "Neodymium magnet, tactical ritual knife, spyglass",
      "location": "Duhrin",
      "look": "Sunken eyes, perpetually amused, pepper hair",
      "name": "Lord Ruthelius Paine",
      "position": 4,
      "title": "Son of the Governor of Duhrin"
    },
    "person/3p0e471i3a": {
      "created_at": "2026-11-04T21:17:45.211Z",
      "description": "Orphanage is run by headmistress Jonel. She frequently has the children put on impromptu plays to keep them busy and out of the seedier parts of the fort. Although the scripts are always of a whimsical nature, many attendees say the events on stage echo their own expeditions into the forest.",
      "equipment": "Field notebook & forensic/invisible inks",
      "location": "Duhrin Orphanage",
      "look": "Smell of herbs, fond of thudding something, swallowing",
      "name": "Headmistress Jonel",
      "position": 2,
      "title": "Leader of the League of Objective Thinking (Preservationists)"
    },
    "person/5s1p036y3l": {
      "created_at": "2026-11-05T19:56:26.905Z",
      "description": "",
      "equipment": "Heavy-duty field knife, Flamethrower, 2 hammers",
      "location": "Duhrin",
      "look": "Dull, hollow eyes, stocky",
      "name": "Marrow",
      "position": 3,
      "title": "Lead thug of the Razers"
    },
    "person/6v1t421y08": {
      "created_at": "2026-11-04T21:10:46.846Z",
      "description": "Old Meg has been widowed several times, yet lives a comfortable life thanks to generous inheritances and her keen eye for business. She turns a steady profit safeguarding the possessions of those who enter the forest. Her secondhand shop is even more lucrative, selling items left by those who never return.",
      "equipment": "Tripwire alarm / bell-wire rig, Heavy combat knife, Flute",
      "location": "Duhrin",
      "look": "Stooped, curt, shrewd",
      "name": "Old Meg",
      "position": 0,
      "title": "Widow, profiteer, shopkeeper"
    },
